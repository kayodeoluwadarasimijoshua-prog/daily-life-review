# ─────────────────────────────────────────────────────────────
# Daily Life Review — environment
# Everything is optional. With no config at all the app runs on a
# local SQLite file and the built-in offline AI engine.
# ─────────────────────────────────────────────────────────────

# ---- Database (required for Vercel / serverless) -------------
# Vercel's filesystem is ephemeral, so use a hosted libSQL database.
# Create a free one at https://turso.tech, then:
#   turso db create daily-life-review
#   turso db show daily-life-review --url
#   turso db tokens create daily-life-review
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Supabase Auth (Google + Email/Password) -----------------
# Create a project at https://supabase.com, then grab these from
# Settings → API. NEXT_PUBLIC_ vars are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Optional: store the local SQLite file elsewhere ----
# DATA_DIR=/var/data

# ---- Optional: swap the built-in AI engine for a real LLM ----
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
